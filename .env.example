# ---------------------------------------------------------------------------
# Phishing Investigation Bot - configuration
# Copy to .env and fill in what you have. Every API key is optional: the bot
# runs the full static analysis without them and simply skips enrichment.
# ---------------------------------------------------------------------------

# --- API server -------------------------------------------------------------
PHISHBOT_HOST=0.0.0.0
PHISHBOT_PORT=8000
PHISHBOT_LOG_LEVEL=INFO

# Shared secret n8n must send as the X-API-Key header. Leave empty to disable.
PHISHBOT_API_KEY=change-me-please

# --- Scoring thresholds (0-100) ---------------------------------------------
PHISHBOT_SUSPICIOUS_THRESHOLD=30
PHISHBOT_MALICIOUS_THRESHOLD=65

# --- Enrichment -------------------------------------------------------------
PHISHBOT_ENRICHMENT_ENABLED=true
PHISHBOT_ENRICHMENT_TIMEOUT=8.0
PHISHBOT_MAX_INDICATORS_PER_PROVIDER=10
PHISHBOT_CACHE_TTL=3600

# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
# https://urlscan.io/user/profile/
URLSCAN_API_KEY=

# --- DNS --------------------------------------------------------------------
PHISHBOT_DNS_ENABLED=false
PHISHBOT_DNS_TIMEOUT=3.0

# --- Org context ------------------------------------------------------------
# Your own domains. Mail claiming to be from these but failing auth is a strong
# spoofing signal. Comma separated.
PHISHBOT_INTERNAL_DOMAINS=example.com,corp.example.com
